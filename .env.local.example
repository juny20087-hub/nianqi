# ===== 廿七 · 提示词工坊 环境变量配置 =====

# 必填：LLM API Key
# 方式一：DeepSeek（推荐）
#   在 https://platform.deepseek.com 控制台创建 API Key
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 方式二：SiliconFlow（硅基流动）
#   在 https://cloud.siliconflow.cn 控制台获取 API Key
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# LLM_MODEL=deepseek-ai/DeepSeek-V3

# 方式三：任意 OpenAI Chat Completions 兼容接口
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
# LLM_BASE_URL=https://你的接口地址/v1
# LLM_MODEL=你的模型名
